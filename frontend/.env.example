# Public API base URL for browser + Next.js server fetches (no trailing slash).
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
#
# Vercel production (set in Vercel Project → Settings → Environment Variables):
# NEXT_PUBLIC_API_BASE_URL=https://ai-competitor-tracker-production.up.railway.app

# Server-side only for app/api/chat (Gemini streaming). Never use NEXT_PUBLIC_.
# Create a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override. Defaults to gemini-3.6-flash (current free-tier model)
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.6-flash
