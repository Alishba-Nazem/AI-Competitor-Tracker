# Copy to .env and fill in local values. Never commit real secrets.

# Direct Postgres URL (required for Prisma Client + prisma db push).
# On Railway: use the Postgres plugin URL (postgresql://...), not prisma://.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Optional local alias for the same direct DB URL (preferred by prisma.config.ts).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Railway injects PORT automatically. For local:
PORT=3000

# Comma-separated allowed frontend origins (your Vercel URL(s))
FRONTEND_URL="http://localhost:3001"
