# Copy to .env and fill in local values. Never commit real secrets.

# Direct Postgres URL (required for Prisma Client + prisma db push).
# On Railway: use the Postgres plugin URL (postgresql://...), not prisma://.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Optional local alias for the same direct DB URL (preferred by prisma.config.ts).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Railway injects PORT automatically. For local:
PORT=3000

# Comma-separated allowed frontend origins (your Vercel URL(s))
FRONTEND_URL="http://localhost:3001"

# Used to sign login/signup tokens. Set a long random value in production.
JWT_SECRET="change-me-in-production"

# Optional. Required only for POST /scheduler/internal/run (manual recapture of
# every active competitor). Daily cron does not use this HTTP route. Leave unset
# to keep that endpoint disabled.
# SCHEDULER_SECRET=""

# Optional. Gemini (free AI Studio key) is preferred for dashboard briefings.
GEMINI_API_KEY=""
# Optional override. Defaults to gemini-3.6-flash
# GEMINI_MODEL="gemini-3.6-flash"

# Optional fallback if Gemini is not set. Claude API needs separate credits
# (a claude.ai subscription does not fund this key).
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
